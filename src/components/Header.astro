---
import Logo from './Logo.astro';
import DesktopNav from './react/DesktopNav';
import MobileNav from './react/MobileNav';
import { getNav } from '@/data/site';
import { languages, languageLabels, localizePath, useTranslations, type Language } from '@/i18n';

interface Props { lang: Language; path: string }
const { lang, path } = Astro.props;
const t = useTranslations(lang);
const nav = getNav(lang);
---

<header id="site-header" class="sticky top-0 z-40 border-b-2 border-transparent transition-[background-color,box-shadow,border-color] duration-300 data-scrolled:border-accent-soft data-scrolled:bg-cream/85 data-scrolled:shadow-md data-scrolled:shadow-accent/10 data-scrolled:backdrop-blur-md">
  <div class="container-x flex h-16 items-center justify-between gap-2 sm:gap-6 lg:h-[4.5rem]">
    <Logo lang={lang} />
    <nav class="hidden lg:block" aria-label={t.common.mainMenu}>
      <DesktopNav client:load items={nav} currentPath={localizePath(path, lang)} homePath={localizePath('/', lang)} />
    </nav>
    <div class="flex shrink-0 items-center gap-2 sm:gap-3">
      <nav aria-label={t.common.language} class="flex items-center gap-0.5 text-xs font-semibold sm:gap-1">
        {languages.map((code) => (
          <a
            href={localizePath(path, code)}
            lang={code}
            hreflang={code}
            aria-current={lang === code ? 'page' : undefined}
            class:list={['rounded-full px-1.5 py-1 transition-colors sm:px-2', lang === code ? 'bg-accent text-ink' : 'text-ink/60 hover:bg-white hover:text-ink']}
          >{languageLabels[code]}</a>
        ))}
      </nav>
      <a id="header-donate" href={localizePath('/#support', lang)} class="btn-primary hidden !py-2 sm:inline-flex">{t.common.donate}</a>
      <div class="lg:hidden">
        <MobileNav
          client:idle
          items={nav}
          siteName={t.siteName}
          donate={{ label: t.common.donate, href: localizePath('/#support', lang) }}
          labels={{ open: t.common.openMenu, close: t.common.closeMenu, description: t.common.siteNavigation }}
        />
      </div>
    </div>
  </div>
  <!-- reading progress, driven by src/scripts/animations.ts; fills the peach bottom line with orange -->
  <div id="scroll-progress" aria-hidden="true" class="absolute inset-x-0 -bottom-0.5 h-0.5 origin-left scale-x-0 bg-accent"></div>
</header>

<script>
  // frosted peach background + orange line once the page scrolls (styled via data-scrolled:* classes)
  const header = document.getElementById('site-header');
  const onScroll = () => header?.toggleAttribute('data-scrolled', window.scrollY > 20);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
