---
import Logo from './Logo.astro';
import DesktopNav from './react/DesktopNav';
import MobileNav from './react/MobileNav';
import { getNav } from '@/data/site';
import { languages, languageLabels, localizePath, useTranslations, type Language } from '@/i18n';

interface Props { lang: Language; path: string }
const { lang, path } = Astro.props;
const t = useTranslations(lang);
const nav = getNav(lang);
---

<header id="site-header" class="sticky top-0 z-40 transition-[background-color,box-shadow] duration-300 data-scrolled:bg-white data-scrolled:shadow-md">
  <div class="container-x flex h-20 items-center justify-between gap-6 lg:h-24">
    <Logo lang={lang} />
    <nav class="hidden lg:block" aria-label={t.common.mainMenu}>
      <DesktopNav client:load items={nav} currentPath={localizePath(path, lang)} homePath={localizePath('/', lang)} />
    </nav>
    <div class="flex items-center gap-3">
      <nav aria-label={t.common.language} class="flex items-center gap-1 text-xs font-semibold">
        {languages.map((code) => (
          <a
            href={localizePath(path, code)}
            lang={code}
            hreflang={code}
            aria-current={lang === code ? 'page' : undefined}
            class:list={['rounded-full px-2 py-1 transition-colors', lang === code ? 'bg-accent text-ink' : 'text-ink/60 hover:bg-white hover:text-ink']}
          >{languageLabels[code]}</a>
        ))}
      </nav>
      <a href={localizePath('/#support', lang)} class="btn-primary hidden !py-3 sm:inline-flex">{t.common.donate}</a>
      <div class="lg:hidden">
        <MobileNav
          client:idle
          items={nav}
          siteName={t.siteName}
          donate={{ label: t.common.donate, href: localizePath('/#support', lang) }}
          labels={{ open: t.common.openMenu, close: t.common.closeMenu, description: t.common.siteNavigation }}
        />
      </div>
    </div>
  </div>
  <!-- reading progress, driven by src/scripts/animations.ts -->
  <div id="scroll-progress" aria-hidden="true" class="absolute inset-x-0 bottom-0 h-[3px] origin-left scale-x-0 bg-gradient-to-r from-accent to-brand"></div>
</header>

<script>
  // white background + shadow once the page scrolls (styled via data-scrolled:* classes)
  const header = document.getElementById('site-header');
  const onScroll = () => header?.toggleAttribute('data-scrolled', window.scrollY > 20);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
