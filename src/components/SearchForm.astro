---
import { blogPath } from '@/data/site';
import { localizePath, useTranslations, type Language } from '@/i18n';
/** `q`: the current query, shown in the box on the results page. */
interface Props { lang: Language; q?: string }
const { lang, q = '' } = Astro.props;
const t = useTranslations(lang).blog;
---

<form
  action={localizePath('/blog/search', lang)}
  method="get"
  data-search-form
  data-all-posts={blogPath(lang)}
  class="mx-auto mt-8 flex max-w-xl gap-2 rounded-full bg-white p-2 text-ink shadow-lg"
>
  <label for="q" class="sr-only">{t.searchLabel}</label>
  <input id="q" name="q" type="search" value={q} placeholder={t.searchPlaceholder} class="w-full rounded-full bg-transparent px-5 outline-none" />
  <button class="btn-primary !py-3" type="submit">{t.searchButton}</button>
</form>

<script>
  // An empty search means "show everything": go to the paginated article list, not /blog/search?q=
  document.querySelectorAll<HTMLFormElement>('[data-search-form]').forEach((form) => {
    form.addEventListener('submit', (e) => {
      const input = form.querySelector<HTMLInputElement>('input[name="q"]');
      if (input && !input.value.trim()) {
        e.preventDefault();
        location.href = form.dataset.allPosts!;
      }
    });
  });
</script>
