---
import { getImage } from 'astro:assets';
import Counter from '../react/Counter';
import HeroButtons from './HeroButtons.astro';
import HeroHeading from '../react/HeroHeading';
import HeroSlider from '../react/HeroSlider';
import { heroSlides, stats } from '@/data/site';
import { useTranslations, type Language } from '@/i18n';
interface Props { lang: Language }
const { lang } = Astro.props;
const t = useTranslations(lang);

// Slider photos: resized + converted to WebP at build time (src/assets/hero/*)
const slides = await Promise.all(
  heroSlides.map(async (src, i) => {
    const img = await getImage({ src, widths: [640, 1024, 1600, 2400], format: 'webp', quality: 75 });
    return { src: img.src, srcSet: img.srcSet.attribute, alt: t.hero.slides[i] };
  }),
);
---

<section class="group/hero relative">
  <!-- photo slider + title (and, on desktop, the buttons) over it -->
  <div class="relative h-[62svh] min-h-[420px] w-full bg-cream lg:h-[calc(100svh-4.5rem)] lg:min-h-[620px]">
    <HeroSlider
      client:load
      slides={slides}
      labels={{ previous: t.common.previous, next: t.common.next, pause: t.hero.pause, play: t.hero.play, slide: t.hero.slideLabel }}
    />
    <div class="pointer-events-none absolute inset-x-0 bottom-8 z-10 lg:bottom-12">
      <div class="container-x">
        <HeroHeading client:load title={t.hero.title} subtitle={t.hero.subtitle} />
        <HeroButtons lang={lang} onPhoto class="pointer-events-auto mt-6 hidden w-fit lg:flex" />
      </div>
    </div>
  </div>

  <!-- buttons below the photos on mobile -->
  <div class="container-x py-8 lg:hidden">
    <HeroButtons lang={lang} />
  </div>
</section>

<!-- Stats / counters -->
<section class="bg-cream pt-4 pb-20 lg:pt-16">
  <div class="container-x">
    <dl class="grid gap-6 rounded-card bg-white p-8 shadow-lg sm:grid-cols-3 sm:p-10">
      {stats.map((s, i) => (
        <div class="flex flex-col border-ink/10 sm:border-r sm:last:border-r-0 sm:px-6 first:sm:pl-0">
          <dt class="order-2 mt-2 text-ink/70">{t.stats[i]}</dt>
          <dd class="text-4xl font-bold lg:text-5xl">
            <Counter client:visible end={s.value} suffix={s.suffix} />
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>
