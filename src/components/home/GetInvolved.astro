---
import { images } from '@/data/site';
const tiles = [
  { label: 'Կամավորություն', href: '#faq', image: images.involved1 },
  { label: 'Գրիր մեզ համար', href: '#contact', image: images.involved2 },
  { label: 'Մասնակցիր միջոցառման', href: '#events', image: images.involved3 },
];
---

<section id="get-involved" class="relative py-20 lg:py-28">
  <div class="container-x">
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow">միացիր մեզ</p>
      <h2 class="section-title">Յուրաքանչյուր պատմություն կարևոր է․ օգնիր մեզ պահպանել դրանք</h2>
    </div>
    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {tiles.map((t) => (
        <a href={t.href} class="group relative block aspect-[4/5] overflow-hidden rounded-[20px]">
          <img src={t.image} alt="" loading="lazy" class="absolute inset-0 size-full object-cover transition-transform duration-700 group-hover:scale-105" />
          <div class="absolute inset-0 bg-gradient-to-t from-ink/60 via-transparent to-transparent"></div>
          <span class="btn-white absolute inset-x-6 bottom-6 group-hover:bg-ink group-hover:text-white">{t.label}</span>
        </a>
      ))}
    </div>
  </div>
</section>
