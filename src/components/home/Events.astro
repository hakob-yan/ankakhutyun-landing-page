---
import { images } from '@/data/site';
import { useTranslations, type Language } from '@/i18n';
interface Props { lang: Language }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="events" class="relative overflow-hidden py-20 lg:py-28">
  <img src={images.dots} alt="" aria-hidden="true" class="pointer-events-none absolute bottom-10 left-0 w-56 opacity-60" />
  <div class="container-x relative grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:gap-20">
    <div class="relative hidden overflow-hidden rounded-card lg:block">
      <img src={images.events} alt="" loading="lazy" class="absolute inset-0 size-full object-cover" />
    </div>
    <div>
      <p class="eyebrow">{t.events.eyebrow}</p>
      <h2 class="section-title">{t.events.title}</h2>
      <ul class="mt-10 divide-y divide-ink/10 border-y border-ink/10">
        {t.events.items.map((e) => (
          <li class="group flex items-center gap-6 py-6">
            <div class="flex size-20 shrink-0 flex-col items-center justify-center rounded-card bg-cream transition-colors duration-300 group-hover:bg-accent">
              <span class="text-3xl leading-none font-bold">{e.day}</span>
              <span class="text-sm font-medium">{e.month}</span>
            </div>
            <div>
              <h3 class="text-xl">{e.title}</h3>
              <p class="mt-1 flex items-center gap-1.5 text-ink/60">
                <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s7-6.5 7-12a7 7 0 1 0-14 0c0 5.5 7 12 7 12z"/><circle cx="12" cy="10" r="2.5"/></svg>
                {e.place}
              </p>
            </div>
          </li>
        ))}
      </ul>
      <a href="#contact" class="link-arrow mt-8">{t.events.all}</a>
    </div>
  </div>
</section>
