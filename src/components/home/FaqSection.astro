---
import Faq from '../react/Faq';
import { faq } from '@/data/site';
---

<section id="faq" class="bg-cream py-20 lg:py-28">
  <div class="container-x grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
    <div>
      <p class="eyebrow">հարցեր</p>
      <h2 class="section-title">Հաճախ տրվող հարցեր</h2>
      <p class="mt-5 text-lg text-ink/75">Չգտա՞ք պատասխանը։ Գրեք մեզ, և մենք սիրով կպատասխանենք։</p>
      <a href="#contact" class="btn-primary mt-8">Կապվել մեզ հետ</a>
    </div>
    <Faq client:visible items={faq} />
  </div>
</section>
