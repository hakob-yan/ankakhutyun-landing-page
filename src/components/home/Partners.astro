---
import { images } from '@/data/site';
import { useTranslations, type Language } from '@/i18n';
interface Props { lang: Language }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="partners" class="pt-20 pb-40 lg:pt-28">
  <div class="container-x grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
    <div>
      <p class="eyebrow">{t.partners.eyebrow}</p>
      <h2 class="section-title">{t.partners.title}</h2>
      <p class="mt-5 text-lg text-ink/75">
        {t.partners.text}
      </p>
    </div>
    <div class="grid grid-cols-2 gap-5">
      {images.partners.map((logo) => (
        <div class="flex h-32 items-center justify-center rounded-card bg-cream p-6 grayscale transition hover:grayscale-0">
          <img src={logo} alt={t.partners.logoAlt} loading="lazy" class="max-h-10 w-auto" />
        </div>
      ))}
    </div>
  </div>
</section>
