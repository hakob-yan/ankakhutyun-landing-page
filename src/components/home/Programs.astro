---
import { programCards, articlesPath } from '@/data/site';
import { useTranslations, type Language } from '@/i18n';
interface Props { lang: Language }
const { lang } = Astro.props;
const t = useTranslations(lang);
const programs = programCards.map((card, i) => ({ ...card, ...t.programs.items[i], href: articlesPath(lang, card.category) }));
---

<section id="programs" class="bg-cream pb-20 lg:pb-28">
  <div class="container-x">
    <div class="mb-12 max-w-2xl">
      <p class="eyebrow">{t.programs.eyebrow}</p>
      <h2 class="section-title">{t.programs.title}</h2>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {programs.map((p) =>
        p.variant === 'photo' ? (
          <a href={p.href} class="group flex flex-col overflow-hidden rounded-card bg-brand">
            <div class="aspect-[4/3] overflow-hidden">
              <img src={p.image} alt="" loading="lazy" class="size-full object-cover transition-transform duration-700 group-hover:scale-105" />
            </div>
            <div class="flex grow flex-col p-7 transition-colors duration-300 group-hover:bg-brand-soft">
              <h3 class="text-2xl">{p.title}</h3>
              <p class="mt-3 text-ink/75">{p.text}</p>
            </div>
          </a>
        ) : (
          <a href={p.href} class="group flex flex-col overflow-hidden rounded-card bg-white p-7 transition-colors duration-300 hover:bg-brand-soft">
            <div class="flex h-44 items-center justify-center">
              <img src={p.image} alt="" aria-hidden="true" loading="lazy" class="h-36 w-auto transition-transform duration-500 group-hover:-rotate-6 group-hover:scale-110" />
            </div>
            <h3 class="mt-auto pt-6 text-2xl">{p.title}</h3>
            <p class="mt-3 text-ink/75">{p.text}</p>
          </a>
        ),
      )}
    </div>
  </div>
</section>
