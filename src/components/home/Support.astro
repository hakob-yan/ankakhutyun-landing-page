---
import DonateWidget from '../react/DonateWidget';
import { images } from '@/data/site';
import { locales } from '@/i18n';
import { useTranslations, type Language } from '@/i18n';
interface Props { lang: Language }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="support" class="relative overflow-hidden bg-brand-soft py-20 lg:py-28">
  <img src={images.shape} alt="" aria-hidden="true" class="pointer-events-none absolute -top-16 -left-16 w-64 opacity-50" />
  <div class="container-x relative grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
    <div>
      <p class="eyebrow">{t.support.eyebrow}</p>
      <h2 class="section-title">{t.support.title}</h2>
      <p class="mt-5 max-w-lg text-lg text-ink/75">
        {t.support.text}
      </p>
      <div class="mt-8 hidden overflow-hidden rounded-card lg:block">
        <img src={images.help} alt="" loading="lazy" class="aspect-[16/9] w-full object-cover" />
      </div>
    </div>
    <DonateWidget client:visible labels={t.donate} locale={locales[lang]} />
  </div>
</section>
