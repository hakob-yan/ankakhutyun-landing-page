---
import { articleUrl, formatDate, type Article } from '@/lib/articles';
import { useTranslations, type Language } from '@/i18n';
/** `lang` is the page's language (labels and date format); the article itself is Armenian. */
interface Props { article: Article; lang: Language; large?: boolean }
const { article, lang, large = false } = Astro.props;
const { title, excerpt, publishedAt, coverImage } = article.data;
const t = useTranslations(lang);
const href = articleUrl(article);
---

<article class:list={['group', large && 'md:col-span-2 md:grid md:grid-cols-2 md:items-center md:gap-10']}>
  <a href={href} class="relative block aspect-[4/3] overflow-hidden rounded-card" tabindex="-1" aria-hidden="true">
    <img src={coverImage} alt="" loading={large ? 'eager' : 'lazy'} class="size-full object-cover transition-transform duration-700 group-hover:scale-105" />
  </a>
  <div class:list={[large ? 'mt-5 md:mt-0' : 'mt-5']}>
    <time datetime={publishedAt.toISOString()} class="text-sm text-ink/60">{formatDate(publishedAt, lang)}</time>
    <h3 lang="hy" class:list={['mt-2 font-bold', large ? 'text-2xl lg:text-4xl' : 'text-xl']}>
      <a href={href} class="decoration-accent decoration-2 underline-offset-4 hover:underline">{title}</a>
    </h3>
    <p lang="hy" class="mt-3 line-clamp-3 text-ink/70">{excerpt}</p>
    <a href={href} class="link-arrow mt-4 text-sm">{t.common.readMore}</a>
  </div>
</article>
