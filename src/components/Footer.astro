---
import Logo from './Logo.astro';
import { getNav, articlesPath } from '@/data/site';
import { articleUrl, getLatestArticles } from '@/lib/articles';
import { ADDRESS, ADDRESS_MAP_URL, EMAIL, EMAIL_HREF, PHONE, PHONE_HREF, SOCIAL_LINKS } from '@/data/contacts';
import { fill, localizePath, useTranslations, type Language } from '@/i18n';

interface Props { lang: Language }
const { lang } = Astro.props;
const t = useTranslations(lang);
const nav = getNav(lang);
const latest = await getLatestArticles(3);
const year = new Date().getFullYear();
---

<footer id="contact" class="relative">
  <div class="bg-night pt-20 pb-10 text-cream">
    <div class="container-x grid gap-12 md:grid-cols-2 lg:grid-cols-4">
      <div>
        <Logo lang={lang} dark />
        <p class="mt-5 text-cream/65">{t.tagline}</p>
        <ul class="mt-6 flex flex-wrap gap-3">
          {SOCIAL_LINKS.map((s) => (
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={s.label}
                title={s.label}
                class="flex size-11 items-center justify-center rounded-full bg-white/10 text-cream ring-1 ring-white/10 transition-colors duration-300 hover:bg-accent hover:text-ink hover:ring-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
              >
                <svg viewBox="0 0 24 24" class="size-[18px]" fill="currentColor" aria-hidden="true"><path d={s.icon} /></svg>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="mb-5 text-lg text-white">{t.footer.navigation}</h3>
        <ul class="space-y-3 text-cream/65">
          {nav.map((n) => <li><a href={n.href} class="decoration-accent decoration-2 underline-offset-4 transition-colors hover:text-white hover:underline">{n.label}</a></li>)}
        </ul>
      </div>

      <div>
        <h3 class="mb-5 text-lg text-white">{t.footer.articles}</h3>
        <ul class="space-y-3 text-cream/65">
          {latest.map((a) => <li><a href={articleUrl(a)} class="line-clamp-2 decoration-accent decoration-2 underline-offset-4 transition-colors hover:text-white hover:underline">{a.title}</a></li>)}
          <li><a href={articlesPath(lang)} class="font-semibold text-accent decoration-2 underline-offset-4 hover:underline">{t.blog.seeAll} →</a></li>
        </ul>
      </div>

      <div>
        <h3 class="mb-5 text-lg text-white">{t.footer.contact}</h3>
        <ul class="space-y-3 text-cream/65">
          <li><a href={ADDRESS_MAP_URL} target="_blank" rel="noopener noreferrer" class="decoration-accent decoration-2 underline-offset-4 transition-colors hover:text-white hover:underline">{ADDRESS[lang]}</a></li>
          <li><a href={EMAIL_HREF} class="decoration-accent decoration-2 underline-offset-4 transition-colors hover:text-white hover:underline">{EMAIL}</a></li>
          <li><a href={PHONE_HREF} class="decoration-accent decoration-2 underline-offset-4 transition-colors hover:text-white hover:underline">{PHONE}</a></li>
        </ul>
      </div>
    </div>

    <div class="container-x mt-14 flex flex-col justify-between gap-4 border-t border-white/10 pt-8 text-sm text-cream/45 sm:flex-row">
      <p>{fill(t.footer.copyright, { year, name: t.siteName })}</p>
      <p class="order-first"><a href={localizePath('/#faq', lang)} title={t.faq.title} class="decoration-accent decoration-2 underline-offset-4 transition-colors hover:text-white hover:underline">{t.footer.faq}</a></p>
    </div>
  </div>
</footer>
