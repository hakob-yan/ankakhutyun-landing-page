---
import Logo from './Logo.astro';
import { getNav, categorySlugs, categoryLabel, articlesPath, images } from '@/data/site';
import { EMAIL, EMAIL_HREF, PHONE, PHONE_HREF, SOCIAL_LINKS } from '@/data/contacts';
import { fill, localizePath, useTranslations, type Language } from '@/i18n';

interface Props { lang: Language }
const { lang } = Astro.props;
const t = useTranslations(lang);
const nav = getNav(lang);
const year = new Date().getFullYear();
---

<footer id="contact" class="relative">
  <!-- "Make a difference" call to action band -->
  <section class="container-x relative z-10 -mb-24">
    <div class="relative overflow-hidden rounded-card bg-linear-to-br from-brand to-brand-dark px-6 py-14 text-ink sm:px-14">
      <img src={images.shape} alt="" aria-hidden="true" class="pointer-events-none absolute -right-10 -bottom-10 w-72 opacity-60" />
      <div class="relative flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
        <div>
          <p class="eyebrow before:bg-white!">{t.footer.ctaEyebrow}</p>
          <h2 class="section-title">{t.footer.ctaTitle}</h2>
        </div>
        <a href={localizePath('/#support', lang)} class="btn-white shrink-0">{t.common.donate}</a>
      </div>
    </div>
  </section>

  <div class="bg-sand pt-40 pb-10 text-ink">
    <div class="container-x grid gap-12 md:grid-cols-2 lg:grid-cols-4">
      <div>
        <Logo lang={lang} />
        <p class="mt-5 text-ink/75">{t.tagline}</p>
        <ul class="mt-6 flex flex-wrap gap-3">
          {SOCIAL_LINKS.map((s) => (
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={s.label}
                title={s.label}
                class="flex size-11 items-center justify-center rounded-full bg-white text-ink transition-all duration-300 hover:-translate-y-0.5 hover:bg-accent hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
              >
                <svg viewBox="0 0 24 24" class="size-[18px]" fill="currentColor" aria-hidden="true"><path d={s.icon} /></svg>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="mb-5 text-lg">{t.footer.navigation}</h3>
        <ul class="space-y-3 text-ink/75">
          {nav.map((n) => <li><a href={n.href} class="decoration-accent decoration-2 underline-offset-4 transition-colors hover:text-ink hover:underline">{n.label}</a></li>)}
        </ul>
      </div>

      <div>
        <h3 class="mb-5 text-lg">{t.footer.articles}</h3>
        <ul class="space-y-3 text-ink/75">
          {categorySlugs.map((slug) => <li><a href={articlesPath(lang, slug)} class="decoration-accent decoration-2 underline-offset-4 transition-colors hover:text-ink hover:underline">{categoryLabel(slug, lang)}</a></li>)}
        </ul>
      </div>

      <div>
        <h3 class="mb-5 text-lg">{t.footer.contact}</h3>
        <ul class="space-y-3 text-ink/75">
          <li>{t.address}</li>
          <li><a href={EMAIL_HREF} class="decoration-accent decoration-2 underline-offset-4 transition-colors hover:text-ink hover:underline">{EMAIL}</a></li>
          <li><a href={PHONE_HREF} class="decoration-accent decoration-2 underline-offset-4 transition-colors hover:text-ink hover:underline">{PHONE}</a></li>
        </ul>
      </div>
    </div>

    <div class="container-x mt-14 flex flex-col justify-between gap-4 border-t border-ink/10 pt-8 text-sm text-ink/60 sm:flex-row">
      <p>{fill(t.footer.copyright, { year, name: t.siteName })}</p>
      <p><a href={localizePath('/#faq', lang)} class="decoration-accent decoration-2 underline-offset-4 transition-colors hover:text-ink hover:underline">{t.faq.title}</a></p>
    </div>
  </div>
</footer>
