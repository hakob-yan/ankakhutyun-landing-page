---
import DonateWidget from './react/DonateWidget';
import { images } from '@/data/site';
import { locales } from '@/i18n';
import { useTranslations, type Language } from '@/i18n';
interface Props { lang: Language }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<!-- /donation page content: light warm-gray section; the white donation form stands out on it -->
<section id="support" class="relative overflow-hidden bg-cream py-20 text-ink lg:py-28">
  <div class="container-x relative grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
    <div>
      <p class="eyebrow">{t.support.eyebrow}</p>
      <h1 class="section-title">{t.support.title}</h1>
      <p class="mt-5 max-w-lg text-lg text-ink/70">
        {t.support.text}
      </p>
      <div class="mt-8 hidden overflow-hidden rounded-card shadow-xl ring-1 ring-ink/5 lg:block">
        <img src={images.help} alt="" loading="lazy" class="aspect-[16/9] w-full object-cover" />
      </div>
    </div>
    <DonateWidget client:visible labels={t.donate} locale={locales[lang]} />
  </div>
</section>
