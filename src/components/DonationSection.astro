---
/**
 * /donation page content:
 *  1. intro + donation form, with an animated photo collage (photos rise in, then float; parallax on scroll)
 *  2. endless photo ribbon
 *  3. "where your donation goes" cards with photos
 * All motion is skipped for visitors who ask for reduced motion.
 */
import { Image } from 'astro:assets';
import DonateWidget from './react/DonateWidget';
import { donateImage, heroSlides } from '@/data/site';
import { locales, useTranslations, type Language } from '@/i18n';
interface Props { lang: Language }
const { lang } = Astro.props;
const t = useTranslations(lang);

const [park, flag, , mountain, school] = heroSlides;

// Collage around the main donation photo: position, tilt, entrance delay, parallax strength.
const collage = [
  { src: donateImage, slot: 'left-0 top-[8%] w-[68%] aspect-[8/7] z-10', tilt: '-2deg', delay: '0.1s', parallax: 0, widths: [480, 800, 1200] },
  { src: school, slot: 'right-0 top-0 w-[38%] aspect-[3/4] z-20', tilt: '4deg', delay: '0.3s', parallax: 30, widths: [320, 640] },
  { src: flag, slot: 'right-[8%] bottom-0 w-[46%] aspect-[4/3] z-30', tilt: '-4deg', delay: '0.5s', parallax: 60, widths: [400, 800] },
];

// Same order as t.support.impact.
const impactCards = [
  { image: park, icon: 'book' },
  { image: mountain, icon: 'people' },
];

const ribbon = [donateImage, ...heroSlides];
---

<!-- 1. Intro + form -->
<section id="support" class="relative overflow-hidden bg-cream pt-12 pb-20 text-ink lg:pt-20 lg:pb-28">
  <!-- decorative shapes -->
  <div aria-hidden="true" class="blob pointer-events-none absolute -top-32 -right-24 h-96 w-96 rounded-full bg-brand-dark/60 blur-3xl"></div>
  <div aria-hidden="true" class="blob blob-2 pointer-events-none absolute -bottom-40 -left-32 h-[28rem] w-[28rem] rounded-full bg-sand blur-3xl"></div>
  <svg aria-hidden="true" class="spin pointer-events-none absolute top-24 left-[46%] hidden h-28 w-28 text-accent/50 lg:block" viewBox="0 0 100 100" fill="none">
    <circle cx="50" cy="50" r="46" stroke="currentColor" stroke-width="3" stroke-dasharray="2 9" stroke-linecap="round" />
  </svg>

  <div class="container-x relative grid grid-cols-1 items-start gap-12 lg:grid-cols-[1.1fr_1fr] lg:gap-16">
    <div class="min-w-0">
      <p class="eyebrow rise" style="--d: 0s">{t.support.eyebrow}</p>
      <h1 class="section-title rise" style="--d: 0.08s">{t.support.title}</h1>
      <p class="rise mt-5 max-w-lg text-lg text-ink/70" style="--d: 0.16s">{t.support.text}</p>

      <div class="relative mx-auto mt-10 aspect-[6/5] w-full max-w-xl lg:mt-12" data-collage>
        {collage.map((c) => (
          <div class={`absolute ${c.slot}`} data-parallax={c.parallax}>
            <div class="collage-in h-full w-full" style={`--d: ${c.delay}`}>
              <div class="collage-float h-full w-full" style={`--r: ${c.tilt}; --fd: ${c.delay}`}>
                <Image
                  src={c.src}
                  alt=""
                  widths={c.widths}
                  sizes="(min-width: 1024px) 30vw, 60vw"
                  loading="eager"
                  class="h-full w-full rounded-card object-cover shadow-2xl ring-4 ring-white"
                />
              </div>
            </div>
          </div>
        ))}

        <!-- heart badge -->
        <div aria-hidden="true" class="collage-in absolute bottom-[6%] left-[4%] z-40" style="--d: 0.75s">
          <span class="pulse-ring absolute inset-0 rounded-full bg-accent"></span>
          <span class="heartbeat relative grid h-16 w-16 place-items-center rounded-full bg-accent text-ink shadow-xl ring-4 ring-white sm:h-20 sm:w-20">
            <svg viewBox="0 0 24 24" class="h-8 w-8 sm:h-9 sm:w-9" fill="currentColor">
              <path d="M12 21s-7.5-4.6-10-9.3C.4 8.4 2.3 4.5 6 4.1c2-.2 3.6.8 4.5 2.2h3c.9-1.4 2.5-2.4 4.5-2.2 3.7.4 5.6 4.3 4 7.6C19.5 16.4 12 21 12 21Z" />
            </svg>
          </span>
        </div>
      </div>
    </div>

    <div class="rise min-w-0 lg:sticky lg:top-28" style="--d: 0.25s">
      <DonateWidget client:visible labels={t.donate} locale={locales[lang]} />
    </div>
  </div>
</section>

<!-- 2. Photo ribbon -->
<div aria-hidden="true" class="ribbon overflow-hidden bg-white py-10">
  <div class="ribbon-track flex w-max">
    {[0, 1].map(() => ribbon.map((src) => (
      <Image src={src} alt="" width={480} loading="lazy" class="mr-5 h-36 w-auto shrink-0 rounded-card object-cover sm:h-48" />
    )))}
  </div>
</div>

<!-- 3. Where your donation goes -->
<section class="bg-white pb-20 lg:pb-28">
  <div class="container-x">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow">{t.support.impactEyebrow}</p>
      <h2 class="section-title">{t.support.impactTitle}</h2>
    </div>
    <div class="mx-auto mt-12 grid max-w-4xl gap-6 md:grid-cols-2">
      {t.support.impact.map((item, i) => (
        <article class="group cta-card flex flex-col transition-transform duration-300 hover:-translate-y-1.5">
          <div class="relative aspect-[4/3] overflow-hidden">
            <Image
              src={impactCards[i].image}
              alt=""
              widths={[400, 800]}
              sizes="(min-width: 768px) 450px, 100vw"
              loading="lazy"
              class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-110"
            />
            <span class="absolute top-4 left-4 rounded-full bg-white/90 px-3 py-1 text-sm font-bold backdrop-blur">0{i + 1}</span>
          </div>
          <div class="relative flex flex-1 flex-col p-6 pt-10">
            <span class="icon-pop absolute -top-7 left-6 grid h-14 w-14 place-items-center rounded-2xl bg-accent text-ink shadow-lg ring-4 ring-white">
              <svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                {impactCards[i].icon === 'book' && <path d="M2 4h6a4 4 0 0 1 4 4v13a3 3 0 0 0-3-3H2zM22 4h-6a4 4 0 0 0-4 4v13a3 3 0 0 1 3-3h7z" />}
                {impactCards[i].icon === 'people' && <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM22 21v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8" />}
              </svg>
            </span>
            <h3 class="text-xl">{item.title}</h3>
            <p class="mt-2 text-ink/70">{item.text}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  import { animate, scroll } from 'motion';

  // Collage photos lag behind at different speeds while the intro scrolls away (they move down, so
  // they never slide over the text above).
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const collage = document.querySelector<HTMLElement>('[data-collage]');
    collage?.querySelectorAll<HTMLElement>('[data-parallax]').forEach((el) => {
      const distance = Number(el.dataset.parallax);
      if (!distance) return;
      scroll(animate(el, { y: [0, distance] }, { ease: 'linear' }), {
        target: collage,
        offset: ['start start', 'end start'],
      });
    });
  }
</script>

<style>
  @media (prefers-reduced-motion: no-preference) {
    /* intro text + form rise in */
    .rise {
      animation: rise 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) var(--d, 0s) both;
    }

    /* collage photos pop in, then keep floating gently */
    .collage-in {
      animation: collage-in 1s cubic-bezier(0.2, 0.9, 0.25, 1.15) var(--d, 0s) both;
    }
    .collage-float {
      animation: float 7s ease-in-out calc(var(--fd, 0s) + 1s) infinite;
    }

    /* heart beats, ring ripples out */
    .heartbeat {
      animation: heartbeat 1.6s ease-in-out 1.6s infinite;
    }
    .pulse-ring {
      animation: pulse-ring 1.6s ease-out 1.6s infinite;
    }

    /* slow decorative motion */
    .spin {
      animation: spin 40s linear infinite;
    }
    .blob {
      animation: blob 14s ease-in-out infinite alternate;
    }
    .blob-2 {
      animation-duration: 18s;
      animation-direction: alternate-reverse;
    }

    /* endless photo ribbon (the track holds the photos twice, so -50% loops seamlessly) */
    .ribbon-track {
      animation: marquee 60s linear infinite;
    }
    .ribbon:hover .ribbon-track {
      animation-play-state: paused;
    }

    /* card icon wiggles on hover */
    .group:hover .icon-pop {
      animation: wiggle 0.6s ease-in-out;
    }
  }

  .collage-float {
    transform: rotate(var(--r, 0deg));
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(28px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes collage-in {
    from { opacity: 0; transform: translateY(60px) scale(0.85); }
    to { opacity: 1; transform: none; }
  }
  @keyframes float {
    0%, 100% { transform: rotate(var(--r, 0deg)) translateY(0); }
    50% { transform: rotate(calc(var(--r, 0deg) * -0.5)) translateY(-14px); }
  }
  @keyframes heartbeat {
    0%, 40%, 100% { transform: scale(1); }
    15% { transform: scale(1.12); }
    30% { transform: scale(0.96); }
  }
  @keyframes pulse-ring {
    from { opacity: 0.55; transform: scale(1); }
    to { opacity: 0; transform: scale(1.8); }
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  @keyframes blob {
    from { transform: translate(0, 0) scale(1); }
    to { transform: translate(-40px, 30px) scale(1.15); }
  }
  @keyframes marquee {
    to { transform: translateX(-50%); }
  }
  @keyframes wiggle {
    0%, 100% { transform: rotate(0); }
    25% { transform: rotate(-10deg) scale(1.08); }
    75% { transform: rotate(8deg) scale(1.08); }
  }
</style>
