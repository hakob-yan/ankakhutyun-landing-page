---
import { localizePath, useTranslations, type Language } from '@/i18n';
interface Props { lang: Language; dark?: boolean }
const { lang, dark = false } = Astro.props;
const t = useTranslations(lang);
---

<a href={localizePath('/', lang)} class="group inline-flex items-center gap-3" aria-label={t.siteName}>
  <span class="flex size-11 shrink-0 items-center justify-center rounded-2xl bg-brand transition-transform duration-300 group-hover:rotate-12">
    <svg viewBox="0 0 24 24" class="size-6" aria-hidden="true"><path d="M12 2l2.6 6.3 6.8.5-5.2 4.4 1.6 6.6L12 16.2l-5.8 3.6 1.6-6.6-5.2-4.4 6.8-.5z" fill="#1D1C1C"/></svg>
  </span>
  <span class:list={['text-[17px] leading-tight font-bold', dark ? 'text-white' : 'text-ink']}>
    {t.logoLines[0]}<br />{t.logoLines[1]}
  </span>
</a>
