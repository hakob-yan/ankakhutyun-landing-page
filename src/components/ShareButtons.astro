---
/** Round icon share buttons (Facebook, Telegram, WhatsApp, copy link) for an article. */
import { siFacebook, siTelegram, siWhatsapp } from 'simple-icons';
import type { Language } from '@/i18n';
import { useTranslations } from '@/i18n';

interface Props {
  url: string;
  title: string;
  lang: Language;
}

const { url, title, lang } = Astro.props;
const t = useTranslations(lang);
const u = encodeURIComponent(url);
const text = encodeURIComponent(title);

const networks = [
  { label: 'Facebook', icon: siFacebook.path, href: `https://www.facebook.com/sharer/sharer.php?u=${u}` },
  { label: 'Telegram', icon: siTelegram.path, href: `https://t.me/share/url?url=${u}&text=${text}` },
  { label: 'WhatsApp', icon: siWhatsapp.path, href: `https://wa.me/?text=${text}%20${u}` },
];

const btn =
  'flex size-11 items-center justify-center rounded-full bg-white text-ink ring-1 ring-ink/15 transition-colors duration-300 hover:bg-accent hover:ring-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent';
---

<div class="flex items-center gap-3">
  <span class="text-sm font-semibold tracking-wider uppercase">{t.article.share}</span>
  <ul class="flex gap-2">
    {networks.map((n) => (
      <li>
        <a href={n.href} target="_blank" rel="noopener noreferrer" aria-label={n.label} title={n.label} class={btn}>
          <svg viewBox="0 0 24 24" class="size-[18px]" fill="currentColor" aria-hidden="true"><path d={n.icon} /></svg>
        </a>
      </li>
    ))}
    <li>
      <button
        type="button"
        class={btn}
        data-copy-link={url}
        data-label={t.article.copyLink}
        data-copied={t.article.linkCopied}
        aria-label={t.article.copyLink}
        title={t.article.copyLink}
      >
        <!-- lucide "link" / "check" -->
        <svg data-icon="link" viewBox="0 0 24 24" class="size-[18px]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
          <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
        </svg>
        <svg data-icon="check" viewBox="0 0 24 24" class="hidden size-[18px]" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 6 9 17l-5-5" />
        </svg>
      </button>
    </li>
  </ul>
  <span class="sr-only" aria-live="polite" data-copy-status></span>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-link]').forEach((button) => {
    const status = button.closest('div')?.querySelector('[data-copy-status]');
    const [linkIcon, checkIcon] = ['link', 'check'].map((i) => button.querySelector(`[data-icon="${i}"]`));
    let timer: number | undefined;

    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copyLink!);
      } catch {
        return; // clipboard blocked (e.g. non-HTTPS) — nothing sensible to show
      }
      const copied = button.dataset.copied!;
      button.title = copied;
      button.setAttribute('aria-label', copied);
      if (status) status.textContent = copied;
      linkIcon?.classList.add('hidden');
      checkIcon?.classList.remove('hidden');

      clearTimeout(timer);
      timer = window.setTimeout(() => {
        const label = button.dataset.label!;
        button.title = label;
        button.setAttribute('aria-label', label);
        if (status) status.textContent = '';
        linkIcon?.classList.remove('hidden');
        checkIcon?.classList.add('hidden');
      }, 2000);
    });
  });
</script>
