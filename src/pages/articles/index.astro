---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { getArticles } from '@/lib/articles';
import { categories, categoryLabel } from '@/data/site';

// Server-rendered: filtering & pagination come from the query string,
// e.g. /articles?category=history&page=2
const PAGE_SIZE = 6;
const params = Astro.url.searchParams;
const category = params.get('category') ?? '';
const validCategory = categories.some((c) => c.slug === category) ? category : '';
const q = (params.get('q') ?? '').trim();

let list = await getArticles();
if (validCategory) list = list.filter((a) => a.data.category === validCategory);
if (q) {
  const needle = q.toLocaleLowerCase('hy');
  list = list.filter((a) =>
    `${a.data.title} ${a.data.description}`.toLocaleLowerCase('hy').includes(needle),
  );
}

const totalPages = Math.max(1, Math.ceil(list.length / PAGE_SIZE));
const page = Math.min(totalPages, Math.max(1, Number(params.get('page')) || 1));
const items = list.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);
const showFeatured = page === 1 && !validCategory && !q && items.length > 0;
const [featured, ...rest] = showFeatured ? items : [undefined, ...items];

const linkFor = (overrides: Record<string, string | number | undefined>) => {
  const u = new URLSearchParams();
  const merged = { category: validCategory, q, page: undefined, ...overrides };
  for (const [k, v] of Object.entries(merged)) if (v !== undefined && v !== '' && !(k === 'page' && String(v) === '1')) u.set(k, String(v));
  const s = u.toString();
  return s ? `/articles?${s}` : '/articles';
};

const pill = (active: boolean) =>
  `rounded-full px-5 py-2.5 text-sm font-semibold transition-colors ${active ? 'bg-ink text-white' : 'bg-white text-ink hover:bg-brand'}`;
---

<BaseLayout
  title={validCategory ? `${categoryLabel(validCategory)} — Հոդվածներ` : 'Հոդվածներ'}
  description="Հոդվածներ, հուշեր և հարցազրույցներ անկախության սերնդի մասին։"
>
  <PageHero
    eyebrow="բլոգ"
    title={validCategory ? categoryLabel(validCategory) : 'Հոդվածներ'}
    subtitle="Պատմություններ, հարցազրույցներ և մտքեր անկախության սերնդի մասին"
  >
    <form action="/articles" method="get" class="mx-auto mt-8 flex max-w-xl gap-2 rounded-full bg-white p-2 shadow-lg">
      {validCategory && <input type="hidden" name="category" value={validCategory} />}
      <label for="q" class="sr-only">Որոնում</label>
      <input id="q" name="q" value={q} placeholder="Որոնել հոդվածներ…" class="w-full rounded-full bg-transparent px-5 outline-none" />
      <button class="btn-primary !py-3" type="submit">Որոնել</button>
    </form>
    <nav class="mt-8 flex flex-wrap justify-center gap-2" aria-label="Կատեգորիաներ">
      <a href={linkFor({ category: '' })} class={pill(!validCategory)}>Բոլորը</a>
      {categories.map((c) => (
        <a href={linkFor({ category: c.slug })} class={pill(validCategory === c.slug)}>{c.label}</a>
      ))}
    </nav>
  </PageHero>

  <section class="container-x py-16 pb-40 lg:py-24 lg:pb-44">
    {q && <p class="mb-8 text-ink/70">«{q}» որոնման արդյունքներ՝ {list.length}</p>}

    {items.length === 0 ? (
      <div class="rounded-[20px] bg-cream p-12 text-center">
        <p class="text-xl font-semibold">Հոդվածներ չեն գտնվել</p>
        <a href="/articles" class="btn-primary mt-6">Տեսնել բոլորը</a>
      </div>
    ) : (
      <div class="grid gap-x-8 gap-y-14 md:grid-cols-2 lg:grid-cols-3">
        {featured && <div class="md:col-span-2 lg:col-span-3"><ArticleCard article={featured} large /></div>}
        {rest.filter(Boolean).map((a) => <ArticleCard article={a!} />)}
      </div>
    )}

    {totalPages > 1 && (
      <nav class="mt-16 flex justify-center gap-2" aria-label="Էջավորում">
        {Array.from({ length: totalPages }, (_, i) => i + 1).map((n) => (
          <a
            href={linkFor({ page: n })}
            aria-current={n === page ? 'page' : undefined}
            class:list={['flex size-12 items-center justify-center rounded-full font-semibold transition-colors', n === page ? 'bg-ink text-white' : 'bg-cream hover:bg-brand']}
          >{n}</a>
        ))}
      </nav>
    )}
  </section>
</BaseLayout>
