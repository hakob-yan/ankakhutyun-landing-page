---
import { getEntry, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCarousel from '@/components/react/ArticleCarousel';
import { getArticles, formatDate, readingMinutes, toCard } from '@/lib/articles';
import { categoryLabel, images } from '@/data/site';

const { slug } = Astro.params;
const article = slug ? await getEntry('articles', slug) : undefined;
if (!article || article.data.draft) {
  return Astro.rewrite('/404');
}

const { Content } = await render(article);
const { title, description, date, category, image, author } = article.data;

const all = await getArticles();
const related = all
  .filter((a) => a.id !== article.id)
  .sort((a, b) => Number(b.data.category === category) - Number(a.data.category === category))
  .slice(0, 6)
  .map(toCard);

const shareUrl = encodeURIComponent(Astro.url.href);
---

<BaseLayout title={title} description={description} image={image}>
  <article>
    <header class="relative -mt-20 overflow-hidden bg-cream pt-36 pb-48 lg:-mt-24 lg:pt-44">
      <img src={images.headerBg} alt="" aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 w-full opacity-70" />
      <div class="container-x relative max-w-4xl text-center">
        <a href={`/articles?category=${category}`} class="inline-block rounded-full bg-brand px-4 py-1.5 text-sm font-semibold hover:bg-ink hover:text-white">
          {categoryLabel(category)}
        </a>
        <h1 class="mt-6 text-3xl sm:text-4xl lg:text-[52px] lg:leading-[1.15]">{title}</h1>
        <p class="mt-6 flex flex-wrap justify-center gap-x-4 gap-y-1 text-ink/60">
          <span>{author}</span><span aria-hidden="true">•</span>
          <time datetime={date.toISOString()}>{formatDate(date)}</time><span aria-hidden="true">•</span>
          <span>{readingMinutes(article.body)} րոպե ընթերցանություն</span>
        </p>
      </div>
    </header>

    <div class="container-x relative z-10 -mt-36 max-w-5xl">
      <img src={image} alt="" class="aspect-[16/9] w-full rounded-[20px] object-cover shadow-2xl" />
    </div>

    <div class="container-x grid max-w-5xl gap-10 py-16 lg:grid-cols-[1fr_200px]">
      <div class="prose prose-lg max-w-none prose-headings:font-bold prose-a:decoration-brand prose-a:decoration-2 prose-blockquote:rounded-r-[20px] prose-blockquote:border-l-brand prose-blockquote:bg-cream prose-blockquote:py-2 prose-blockquote:not-italic prose-li:marker:text-brand">
        <p class="lead">{description}</p>
        <Content />
      </div>
      <aside class="lg:sticky lg:top-28 lg:self-start">
        <p class="mb-3 text-sm font-semibold tracking-wider uppercase">Կիսվել</p>
        <div class="flex gap-2 lg:flex-col">
          <a class="btn-outline !px-4 !py-2 text-sm" target="_blank" rel="noopener" href={`https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`}>Facebook</a>
          <a class="btn-outline !px-4 !py-2 text-sm" target="_blank" rel="noopener" href={`https://t.me/share/url?url=${shareUrl}`}>Telegram</a>
        </div>
        <a href="/articles" class="link-arrow mt-8 text-sm">← Բոլոր հոդվածները</a>
      </aside>
    </div>
  </article>

  {related.length > 0 && (
    <section class="bg-cream-light py-20 pb-44">
      <div class="container-x">
        <p class="eyebrow">կարդացեք նաև</p>
        <h2 class="section-title mb-12">Նմանատիպ հոդվածներ</h2>
        <ArticleCarousel client:visible articles={related} />
      </div>
    </section>
  )}
</BaseLayout>
