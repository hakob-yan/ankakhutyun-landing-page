---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCarousel from '@/components/react/ArticleCarousel';
import { articleLang, articleSlug, formatDate, getArticles, readingMinutes, toCard, type Article } from '@/lib/articles';
import { articlesPath, categoryLabel, images } from '@/data/site';
import { fill, langParam, localizePath, useTranslations } from '@/i18n';

// One page per article per language: /articles/<slug>, /en/articles/<slug>, /ru/articles/<slug>
export const getStaticPaths = (async () => {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((article) => ({
    params: { lang: langParam(articleLang(article)), slug: articleSlug(article) },
    props: { article },
  }));
}) satisfies GetStaticPaths;

const { article } = Astro.props as { article: Article };
const lang = articleLang(article);
const slug = articleSlug(article);
const t = useTranslations(lang);

const { Content } = await render(article);
const { title, description, date, category, image, author } = article.data;

const related = (await getArticles(lang))
  .filter((a) => a.id !== article.id)
  .sort((a, b) => Number(b.data.category === category) - Number(a.data.category === category))
  .slice(0, 6)
  .map(toCard);

const shareUrl = encodeURIComponent(new URL(localizePath(`/articles/${slug}`, lang), Astro.site).href);
---

<BaseLayout lang={lang} path={`/articles/${slug}`} title={title} description={description} image={image}>
  <article>
    <header class="relative -mt-16 overflow-hidden bg-cream pt-32 pb-48 lg:-mt-[4.5rem] lg:pt-[9.5rem]">
      <img src={images.headerBg} alt="" aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 w-full opacity-70" />
      <div class="container-x relative max-w-4xl text-center">
        <a href={articlesPath(lang, category)} class="inline-block rounded-full bg-accent px-4 py-1.5 text-sm font-semibold text-ink ring-accent transition-colors hover:bg-white hover:ring-2">
          {categoryLabel(category, lang)}
        </a>
        <h1 class="mt-6 text-3xl sm:text-4xl lg:text-[52px] lg:leading-[1.15]">{title}</h1>
        <p class="mt-6 flex flex-wrap justify-center gap-x-4 gap-y-1 text-ink/60">
          <span>{author}</span><span aria-hidden="true">•</span>
          <time datetime={date.toISOString()}>{formatDate(date, lang)}</time><span aria-hidden="true">•</span>
          <span>{fill(t.article.minRead, { n: readingMinutes(article.body) })}</span>
        </p>
      </div>
    </header>

    <div class="container-x relative z-10 -mt-36 max-w-5xl">
      <img src={image} alt="" class="aspect-[16/9] w-full rounded-card object-cover shadow-2xl" />
    </div>

    <div class="container-x grid max-w-5xl gap-10 py-16 lg:grid-cols-[1fr_200px]">
      <div class="prose prose-lg max-w-none prose-headings:font-bold prose-a:text-ink prose-a:decoration-accent prose-a:decoration-2 prose-blockquote:rounded-r-card prose-blockquote:border-l-accent prose-blockquote:bg-accent-soft prose-blockquote:py-2 prose-blockquote:not-italic prose-li:marker:text-accent">
        <p class="lead">{description}</p>
        <Content />
      </div>
      <aside class="lg:sticky lg:top-28 lg:self-start">
        <p class="mb-3 text-sm font-semibold tracking-wider uppercase">{t.article.share}</p>
        <div class="flex gap-2 lg:flex-col">
          <a class="btn-outline !px-4 !py-2 text-sm" target="_blank" rel="noopener" href={`https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`}>Facebook</a>
          <a class="btn-outline !px-4 !py-2 text-sm" target="_blank" rel="noopener" href={`https://t.me/share/url?url=${shareUrl}`}>Telegram</a>
        </div>
        <a href={articlesPath(lang)} class="link-arrow mt-8 text-sm">{t.article.allArticles}</a>
      </aside>
    </div>
  </article>

  {related.length > 0 && (
    <section class="bg-cream-light py-20 pb-44">
      <div class="container-x">
        <p class="eyebrow">{t.article.readAlso}</p>
        <h2 class="section-title mb-12">{t.article.related}</h2>
        <ArticleCarousel client:visible articles={related} labels={t.common} />
      </div>
    </section>
  )}
</BaseLayout>
