---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { articleLang, articleSlug, formatDate, readingMinutes, type Article } from '@/lib/articles';
import { articlesPath, categoryLabel } from '@/data/site';
import HeroBackdrop from '@/components/HeroBackdrop.astro';
import ShareButtons from '@/components/ShareButtons.astro';
import { fill, langParam, localizePath, useTranslations } from '@/i18n';

// One page per article per language: /articles/<slug>, /en/articles/<slug>, /ru/articles/<slug>
export const getStaticPaths = (async () => {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((article) => ({
    params: { lang: langParam(articleLang(article)), slug: articleSlug(article) },
    props: { article },
  }));
}) satisfies GetStaticPaths;

const { article } = Astro.props as { article: Article };
const lang = articleLang(article);
const slug = articleSlug(article);
const t = useTranslations(lang);

const { Content } = await render(article);
const { title, description, date, category, image, author } = article.data;

const shareUrl = new URL(localizePath(`/articles/${slug}`, lang), Astro.site).href;
---

<BaseLayout lang={lang} path={`/articles/${slug}`} title={title} description={description} image={image}>
  <article>
    <!-- dark header with the globe animation (same as the other pages' banners) -->
    <header class="relative overflow-hidden bg-night pt-16 pb-48 text-cream lg:pt-20">
      <HeroBackdrop />
      <div class="container-x relative max-w-4xl text-center">
        <span class="inline-block rounded-full bg-accent px-4 py-1.5 text-sm font-semibold text-ink">
          {categoryLabel(category, lang)}
        </span>
        <h1 class="mt-6 text-3xl text-white sm:text-4xl lg:text-[52px] lg:leading-[1.15]">{title}</h1>
        <p class="mt-6 flex flex-wrap justify-center gap-x-4 gap-y-1 text-cream/60">
          <span>{author}</span><span aria-hidden="true">•</span>
          <time datetime={date.toISOString()}>{formatDate(date, lang)}</time><span aria-hidden="true">•</span>
          <span>{fill(t.article.minRead, { n: readingMinutes(article.body) })}</span>
        </p>
      </div>
    </header>

    <div class="container-x relative z-10 -mt-36 max-w-5xl">
      <img src={image} alt="" class="aspect-[16/9] w-full rounded-card object-cover shadow-2xl" />
    </div>

    <div class="container-x max-w-3xl py-16 pb-40 lg:pb-44">
      <div class="prose prose-lg max-w-none prose-headings:font-bold prose-a:text-ink prose-a:decoration-accent prose-a:decoration-2 prose-blockquote:rounded-r-card prose-blockquote:border-l-accent prose-blockquote:bg-accent-soft prose-blockquote:py-2 prose-blockquote:not-italic prose-li:marker:text-accent">
        <p class="lead">{description}</p>
        <Content />
      </div>

      <footer class="mt-14 flex flex-col-reverse gap-6 border-t border-ink/10 pt-8 sm:flex-row sm:items-center sm:justify-between">
        <a href={articlesPath(lang)} class="link-arrow self-start text-sm sm:self-auto">{t.article.allArticles}</a>
        <ShareButtons url={shareUrl} title={title} lang={lang} />
      </footer>
    </div>
  </article>
</BaseLayout>
