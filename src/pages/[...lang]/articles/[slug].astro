---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroBackdrop from '@/components/HeroBackdrop.astro';
import ShareButtons from '@/components/ShareButtons.astro';
import { ARTICLE_LANG, articleUrl, formatDate, readingMinutes, type Article } from '@/lib/articles';
import { articlesPath } from '@/data/site';
import { fill, langParam, useTranslations } from '@/i18n';

// One static page per published article, in Armenian only: /articles/<slug>.
// (/en/articles and /ru/articles list the same articles and link here.)
export const getStaticPaths = (async () => {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { lang: langParam('hy'), slug: article.id },
    props: { article },
  }));
}) satisfies GetStaticPaths;

const { article } = Astro.props as { article: Article };
const lang = ARTICLE_LANG;
const t = useTranslations(lang);
const { title, excerpt, content, coverImage, publishedAt, updatedAt } = article.data;

const path = `/articles/${article.id}`;
const url = new URL(articleUrl(article), Astro.site).href;

// Structured data so search engines show it as an article (headline, image, dates).
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: excerpt,
  image: [coverImage],
  datePublished: publishedAt.toISOString(),
  dateModified: updatedAt.toISOString(),
  inLanguage: 'hy',
  mainEntityOfPage: url,
  publisher: { '@type': 'Organization', name: t.siteName },
};
---

<BaseLayout
  lang={lang}
  path={path}
  title={title}
  description={excerpt}
  image={coverImage}
  alternates={false}
  otherLanguagesPath="/articles"
  ogType="article"
  publishedAt={publishedAt}
  modifiedAt={updatedAt}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <article>
    <!-- dark header with the globe animation (same as the other pages' banners) -->
    <header class="relative overflow-hidden bg-night pt-16 pb-48 text-cream lg:pt-20">
      <HeroBackdrop />
      <div class="container-x relative max-w-4xl text-center">
        <h1 class="text-3xl text-white sm:text-4xl lg:text-[52px] lg:leading-[1.15]">{title}</h1>
        <p class="mt-6 flex flex-wrap justify-center gap-x-4 gap-y-1 text-cream/60">
          <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt, lang)}</time><span aria-hidden="true">•</span>
          <span>{fill(t.article.minRead, { n: readingMinutes(content) })}</span>
        </p>
      </div>
    </header>

    <div class="container-x relative z-10 -mt-36 max-w-5xl">
      <img src={coverImage} alt="" fetchpriority="high" class="aspect-[16/9] w-full rounded-card object-cover shadow-2xl" />
    </div>

    <div class="container-x max-w-3xl py-16 pb-40 lg:pb-44">
      <p class="text-xl leading-relaxed text-ink/80">{excerpt}</p>
      <!-- Sanitized HTML from the admin editor (the server allows only editor tags). flow-root contains floated images. -->
      <div
        class="prose prose-lg mt-8 flow-root max-w-none prose-headings:font-bold prose-a:text-ink prose-a:decoration-accent prose-a:decoration-2 prose-blockquote:rounded-r-card prose-blockquote:border-l-accent prose-blockquote:bg-accent-soft prose-blockquote:py-2 prose-blockquote:not-italic prose-img:rounded-card prose-li:marker:text-accent"
        set:html={content}
      />

      <footer class="mt-14 flex flex-col-reverse gap-6 border-t border-ink/10 pt-8 sm:flex-row sm:items-center sm:justify-between">
        <a href={articlesPath(lang)} class="link-arrow self-start text-sm sm:self-auto">{t.article.allArticles}</a>
        <ShareButtons url={url} title={title} lang={lang} />
      </footer>
    </div>
  </article>
</BaseLayout>
