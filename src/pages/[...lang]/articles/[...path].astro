---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SearchForm from '@/components/SearchForm.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { getArticles, type Article } from '@/lib/articles';
import { articlesPath } from '@/data/site';
import { languages, langParam, stripLanguage, useTranslations, type Language } from '@/i18n';

// Pre-builds every list page for every language: /articles, /articles/page/2 …
export const getStaticPaths = (async () => {
  const PAGE_SIZE = 6; // must live inside getStaticPaths (it runs in isolation)
  const paths = [];
  for (const lang of languages) {
    const all = await getArticles(); // same (Armenian) articles on every language's list
    const totalPages = Math.max(1, Math.ceil(all.length / PAGE_SIZE));
    for (let page = 1; page <= totalPages; page++) {
      const path = stripLanguage(articlesPath(lang, page)).replace(/^\/articles\/?/, '') || undefined;
      paths.push({
        params: { lang: langParam(lang), path },
        props: { lang, page, totalPages, items: all.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE) },
      });
    }
  }
  return paths;
}) satisfies GetStaticPaths;

interface Props {
  lang: Language;
  page: number;
  totalPages: number;
  items: Article[];
}
const { lang, page, totalPages, items } = Astro.props;
const t = useTranslations(lang);

// the newest published article is shown large at the top of the first page
const featured = page === 1 ? items[0] : undefined;
const rest = featured ? items.slice(1) : items;
---

<BaseLayout
  lang={lang}
  path={stripLanguage(articlesPath(lang, page))}
  title={t.blog.title}
  description={t.blog.description}
>
  <PageHero eyebrow={t.blog.eyebrow} title={t.blog.title} subtitle={t.blog.subtitle}>
    <SearchForm lang={lang} />
  </PageHero>

  <section class="container-x py-16 pb-40 lg:py-24 lg:pb-44">
    {items.length === 0 ? (
      <div class="rounded-card bg-cream p-12 text-center">
        <p class="text-xl font-semibold">{t.blog.notFound}</p>
        <a href={articlesPath(lang)} class="btn-primary mt-6">{t.blog.seeAll}</a>
      </div>
    ) : (
      <div class="grid gap-x-8 gap-y-14 md:grid-cols-2 lg:grid-cols-3">
        {featured && <div class="md:col-span-2 lg:col-span-3"><ArticleCard article={featured} lang={lang} large /></div>}
        {rest.map((a) => <ArticleCard article={a} lang={lang} />)}
      </div>
    )}

    {totalPages > 1 && (
      <nav class="mt-16 flex justify-center gap-2" aria-label={t.blog.pagination}>
        {Array.from({ length: totalPages }, (_, i) => i + 1).map((n) => (
          <a
            href={articlesPath(lang, n)}
            aria-current={n === page ? 'page' : undefined}
            class:list={['flex size-12 items-center justify-center rounded-full font-semibold transition-colors', n === page ? 'bg-accent text-ink' : 'bg-cream ring-accent hover:bg-white hover:ring-2']}
          >{n}</a>
        ))}
      </nav>
    )}
  </section>
</BaseLayout>
