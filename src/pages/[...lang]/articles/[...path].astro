---
import { localizePath } from '@/i18n';
import { routeLanguage } from '@/lib/articles';

// The blog used to live at /articles. Old links (/articles, /articles/<slug>, /articles/page/2,
// /articles/search?q=…, and the /en/, /ru/ versions) permanently redirect to the same page under /blog.
const lang = routeLanguage(Astro.params.lang);
if (!lang) return new Response(null, { status: 404, statusText: 'Not found' });
const rest = Astro.params.path ? `/${Astro.params.path}` : '';
return Astro.redirect(localizePath(`/blog${rest}`, lang) + Astro.url.search, 301);
---
