---
import { Image } from 'astro:assets';
import { Play } from 'lucide-react';
import { siYoutube } from 'simple-icons';
import BaseLayout from '@/layouts/BaseLayout.astro';
import StairsSpinner from '@/components/StairsSpinner.astro';
import { episodes, episodeUrl } from '@/data/podcast';
import { YOUTUBE_URL } from '@/data/contacts';
import { externalLinkProps } from '@/data/site';
import { useTranslations } from '@/i18n';
import { routeLanguage } from '@/lib/articles';

// /podcast, /en/podcast and /ru/podcast
const lang = routeLanguage(Astro.params.lang);
if (!lang) return new Response(null, { status: 404, statusText: 'Not found' });
const dict = useTranslations(lang);
const t = dict.podcast;
const [featured, ...rest] = episodes;
---

<BaseLayout lang={lang} path="/podcast" title={t.title} description={t.description}>
  <!-- intro + episode collage on the light warm-gray band -->
  <section class="relative overflow-hidden bg-cream pt-12 pb-20 lg:pt-16 lg:pb-28">
    <div class="container-x relative">
      <div class="grid items-end gap-8 lg:grid-cols-[minmax(0,1fr)_auto] lg:gap-16">
        <div class="max-w-3xl">
          <p class="eyebrow">{t.eyebrow}</p>
          <h1 class="section-title">{t.title}</h1>
          <p class="mt-5 text-lg text-ink/70">{t.intro}</p>
        </div>
        <a href={YOUTUBE_URL} {...externalLinkProps} class="btn-primary self-start lg:self-end">
          <svg viewBox="0 0 24 24" class="size-5" fill="currentColor" aria-hidden="true"><path d={siYoutube.path} /></svg>
          {t.watchChannel}
        </a>
      </div>

      <h2 class="sr-only">{t.latest}</h2>
      <!--
        Bento collage: the newest episode large on the left, the next four in a 2×2 grid on the right.
        Covers stay 16:9 (they carry the episode title as text, so they must not be cropped much).
      -->
      <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:mt-14 lg:grid-cols-4 lg:gap-5">
        {featured && (
          <li class="relative sm:col-span-2 lg:row-span-2">
            <!-- amber offset block behind the featured cover -->
            <div aria-hidden="true" class="absolute inset-0 hidden translate-x-3 translate-y-3 rounded-card bg-accent lg:block"></div>
            <a href={episodeUrl(featured)} {...externalLinkProps} class="group relative block h-full overflow-hidden rounded-card bg-night shadow-xl ring-1 ring-ink/10">
              <Image src={featured.cover} alt="" widths={[640, 960, 1280]} sizes="(min-width: 1024px) 50vw, 100vw" class="aspect-video w-full object-cover transition-transform lg:h-full duration-700 group-hover:scale-105" />
              <!-- caption: under the cover on small screens, overlaid on its bottom edge on desktop -->
              <div class="flex items-center justify-between gap-4 bg-night px-5 py-4 text-cream sm:px-6 lg:absolute lg:inset-x-0 lg:bottom-0 lg:bg-night/85 lg:backdrop-blur-sm">
                <div class="min-w-0">
                  <p class="text-xs font-semibold tracking-wider text-accent uppercase">{t.episode} #{featured.number}</p>
                  <p class="mt-1 text-lg font-semibold text-white sm:text-xl lg:truncate">{featured.topic[lang]}</p>
                </div>
                <span class="flex size-12 shrink-0 items-center justify-center rounded-full bg-accent text-ink transition-transform duration-300 group-hover:scale-110">
                  <Play className="size-5 translate-x-px fill-current" aria-hidden="true" />
                </span>
              </div>
              <span class="sr-only">{t.watch}: {t.episode} #{featured.number}, {featured.topic[lang]}</span>
            </a>
          </li>
        )}
        {rest.map((e) => (
          <li>
            <a href={episodeUrl(e)} {...externalLinkProps} class="group relative block overflow-hidden rounded-card bg-night shadow-md ring-1 ring-ink/10">
              <Image src={e.cover} alt="" widths={[480, 640]} sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw" class="aspect-video w-full object-cover transition-transform duration-700 group-hover:scale-105" />
              <!-- on hover: dark veil with the episode topic and a play button -->
              <div class="absolute inset-0 flex flex-col justify-end bg-night/0 p-4 text-cream transition-colors duration-300 group-hover:bg-night/75 group-focus-visible:bg-night/75">
                <div class="translate-y-2 opacity-0 transition duration-300 group-hover:translate-y-0 group-hover:opacity-100 group-focus-visible:translate-y-0 group-focus-visible:opacity-100">
                  <p class="text-xs font-semibold tracking-wider text-accent uppercase">{t.episode} #{e.number}</p>
                  <p class="mt-1 line-clamp-2 font-semibold text-white">{e.topic[lang]}</p>
                </div>
              </div>
              <span class="absolute top-3 right-3 flex size-9 items-center justify-center rounded-full bg-accent text-ink shadow-md transition-transform duration-300 group-hover:scale-110">
                <Play className="size-4 translate-x-px fill-current" aria-hidden="true" />
              </span>
              <span class="sr-only">{t.watch}: {t.episode} #{e.number}, {e.topic[lang]}</span>
            </a>
          </li>
        ))}
      </ul>

      <div class="mt-10 text-center lg:mt-12">
        <a href={`${YOUTUBE_URL}/videos`} {...externalLinkProps} class="link-arrow">{t.allEpisodes} →</a>
      </div>
    </div>
  </section>

  <!-- subscribe -->
  <section class="container-x py-20 pb-40 lg:py-28 lg:pb-44">
    <div class="cta-card px-6 py-14 text-center sm:px-12 lg:py-20">
      <StairsSpinner class="absolute right-4 bottom-4 hidden w-28 opacity-80 sm:block" />
      <div class="relative mx-auto max-w-2xl">
        <h2 class="section-title">{t.subscribeTitle}</h2>
        <p class="mt-5 text-lg text-ink/70">{t.subscribeText}</p>
        <a href={`${YOUTUBE_URL}?sub_confirmation=1`} {...externalLinkProps} class="btn-primary mt-8">
          <svg viewBox="0 0 24 24" class="size-5" fill="currentColor" aria-hidden="true"><path d={siYoutube.path} /></svg>
          {t.subscribe}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
