---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import StairsSpinner from '@/components/StairsSpinner.astro';
import BoardGrid from '@/components/react/BoardGrid';
import { getBoard } from '@/data/board';
import { useTranslations } from '@/i18n';
import { routeLanguage } from '@/lib/articles';

// /board, /en/board and /ru/board
const lang = routeLanguage(Astro.params.lang);
if (!lang) return new Response(null, { status: 404, statusText: 'Not found' });
const dict = useTranslations(lang);
const t = dict.board;
const all = getBoard(lang);
const chair = all.find((m) => m.chair);
const members = all.filter((m) => !m.chair);
---

<BaseLayout lang={lang} path="/board" title={dict.nav.board} description={t.description}>
  <PageHero eyebrow={t.eyebrow} title={t.title} subtitle={t.subtitle} />

  <!-- chair spotlight -->
  {chair && (
    <section class="container-x py-16 lg:py-24">
      <div class="grid items-center gap-12 lg:grid-cols-[5fr_7fr] lg:gap-20">
        <div class="relative mx-auto w-full max-w-sm animate-fade-up">
          <!-- slowly turning dashed ring around the photo -->
          <svg viewBox="0 0 100 100" aria-hidden="true" class="absolute -inset-5 size-[calc(100%+2.5rem)] animate-[spin_40s_linear_infinite] text-accent">
            <circle cx="50" cy="50" r="48" fill="none" stroke="currentColor" stroke-width="0.6" stroke-dasharray="1 3" stroke-linecap="round" />
          </svg>
          <div class="relative aspect-square overflow-hidden rounded-full bg-cream ring-8 ring-cream">
            <img src={chair.photo} alt={chair.name} class="size-full object-cover" />
          </div>
          <div class="absolute -right-2 bottom-4 rounded-card bg-night p-3 shadow-xl">
            <StairsSpinner class="size-14" />
          </div>
        </div>

        <figure class="animate-fade-up [animation-delay:150ms]">
          <span aria-hidden="true" class="block font-serif text-8xl leading-none text-accent">“</span>
          <blockquote class="-mt-6 text-2xl leading-snug font-semibold sm:text-3xl lg:text-[34px]">{chair.quote}</blockquote>
          <figcaption class="mt-8 flex items-center gap-4">
            <span class="h-1 w-10 rounded-full bg-accent" aria-hidden="true"></span>
            <span>
              <span class="block text-lg font-bold">{chair.name}</span>
              <span class="block text-ink/60">{chair.role} · {chair.occupation}</span>
            </span>
          </figcaption>
          <p class="mt-6 max-w-xl text-ink/70">{chair.bio}</p>
        </figure>
      </div>
    </section>
  )}

  <!-- members -->
  <section class="bg-cream py-16 lg:py-24">
    <div class="container-x">
      <h2 class="mb-10 flex items-center gap-4 text-2xl lg:mb-14 lg:text-3xl">
        <span class="h-1 w-10 rounded-full bg-accent" aria-hidden="true"></span>
        {t.membersTitle}
      </h2>
      <BoardGrid client:visible members={members} labels={{ since: t.since, more: t.more, less: t.less }} />
    </div>
  </section>

  <!-- how the board works -->
  <section class="container-x py-16 pb-40 lg:py-24 lg:pb-44">
    <h2 class="mb-10 text-center text-2xl lg:text-3xl">{t.howTitle}</h2>
    <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {t.facts.map((f, i) => (
        <li class="cta-card animate-fade-up p-7 text-center" style={`animation-delay:${i * 100}ms`}>
          <p class="text-5xl font-bold text-accent">{f.value}</p>
          <p class="mt-3 text-ink/70">{f.label}</p>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
