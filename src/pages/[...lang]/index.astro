---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/home/Hero.astro';
import Support from '@/components/home/Support.astro';
import GetInvolved from '@/components/home/GetInvolved.astro';
import About from '@/components/home/About.astro';
import Programs from '@/components/home/Programs.astro';
import Events from '@/components/home/Events.astro';
import LatestArticles from '@/components/home/LatestArticles.astro';
import FaqSection from '@/components/home/FaqSection.astro';
import Partners from '@/components/home/Partners.astro';
import { languagePaths, type Language } from '@/i18n';

// Builds /, /en/ and /ru/
export const getStaticPaths = languagePaths;
const { lang } = Astro.props as { lang: Language };
---

<BaseLayout lang={lang} path="/">
  <Hero lang={lang} />
  <Support lang={lang} />
  <GetInvolved lang={lang} />
  <About lang={lang} />
  <Programs lang={lang} />
  <Events lang={lang} />
  <LatestArticles lang={lang} />
  <FaqSection lang={lang} />
  <Partners lang={lang} />
</BaseLayout>
