---
import { getImage } from 'astro:assets';
import { MapPin, Sparkles, Sun, Users } from 'lucide-react';
import { siInstagram } from 'simple-icons';
import BaseLayout from '@/layouts/BaseLayout.astro';
import StairsSpinner from '@/components/StairsSpinner.astro';
import Counter from '@/components/react/Counter';
import { heroSlides, externalLinkProps } from '@/data/site';
import { EMAIL_HREF, INSTAGRAM_URL } from '@/data/contacts';
import { fill, useTranslations } from '@/i18n';
import { routeLanguage } from '@/lib/articles';

// /power-of-independence, /en/power-of-independence and /ru/power-of-independence
const lang = routeLanguage(Astro.params.lang);
if (!lang) return new Response(null, { status: 404, statusText: 'Not found' });
const dict = useTranslations(lang);
const t = dict.power;

/** Number of camps held so far. */
const CAMPS = 5;
const infoIcons = [Sun, MapPin, Users, Sparkles];

// camp photos (the site's own photos, shared with the home hero); alt texts from ui.hero.slides
const photos = await Promise.all(
  heroSlides.map(async (src, i) => ({
    src: (await getImage({ src, width: 640, format: 'webp', quality: 75 })).src,
    alt: dict.hero.slides[i] ?? '',
  })),
);
// two marquee rows that move in opposite directions; the second row starts at a different photo
const rowA = photos;
const rowB = [...photos.slice(2), ...photos.slice(0, 2)];
---

<BaseLayout lang={lang} path="/power-of-independence" title={t.title} description={t.description}>
  <!-- intro + "5 camps" -->
  <section class="bg-cream pt-12 pb-14 lg:pt-16 lg:pb-16">
    <div class="container-x grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_auto] lg:gap-16">
      <div class="max-w-3xl">
        <p class="eyebrow">{t.eyebrow}</p>
        <h1 class="section-title">{t.title}</h1>
        <p class="mt-5 text-lg text-ink/70">{t.intro}</p>
      </div>

      <div class="flex flex-col items-start gap-4 lg:items-center">
        <p class="text-sm font-semibold tracking-wider text-ink/60 uppercase">{t.campsHeldText}</p>
        <div class="flex items-end gap-3">
          <span class="text-8xl leading-none font-bold text-accent lg:text-9xl"><Counter client:visible end={CAMPS} /></span>
          <span class="pb-2 text-2xl font-semibold">{t.campsHeld}</span>
        </div>
        <!-- one pill per camp; they light up one after another -->
        <ol class="flex gap-2" aria-label={`${CAMPS} ${t.campsHeld}`}>
          {Array.from({ length: CAMPS }, (_, i) => (
            <li class="camp-pill flex size-10 items-center justify-center rounded-full bg-white text-sm font-bold text-ink/40 ring-1 ring-ink/10" style={`--i:${i}`} title={fill(t.camp, { n: i + 1 })}>
              {i + 1}
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- photo marquee: two tilted rows scrolling in opposite directions (pauses on hover; static with reduced motion) -->
  <section class="overflow-hidden bg-cream pb-16 lg:pb-24" aria-label={t.title}>
    <div class="-rotate-2 space-y-4 lg:space-y-5">
      {[rowA, rowB].map((row, r) => (
        <div class="marquee">
          <!-- the list is repeated so the loop is seamless; the copy is hidden from screen readers -->
          <div class:list={['marquee-track', r === 1 && 'reverse']}>
            {[0, 1].map((copy) => (
              <ul class="flex shrink-0 gap-4 pr-4 lg:gap-5 lg:pr-5" aria-hidden={copy === 1 ? 'true' : undefined}>
                {row.map((p, i) => (
                  <li class:list={['w-64 shrink-0 overflow-hidden rounded-card shadow-lg ring-4 ring-white sm:w-80 lg:w-96', (i + r) % 2 ? 'rotate-1' : '-rotate-1']}>
                    <img src={p.src} alt={copy === 0 ? p.alt : ''} loading="lazy" class="aspect-[4/3] w-full object-cover" />
                  </li>
                ))}
              </ul>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- general info -->
  <section class="container-x py-20 lg:py-28">
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 class="section-title">{t.infoTitle}</h2>
    </div>
    <ul class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {t.info.map((item, i) => {
        const Icon = infoIcons[i];
        return (
          <li class="cta-card p-7">
            <span class="inline-flex size-14 items-center justify-center rounded-full bg-sand">
              <Icon className="size-7 text-ink" aria-hidden="true" />
            </span>
            <h3 class="mt-6 text-xl">{item.title}</h3>
            <p class="mt-3 text-ink/70">{item.text}</p>
          </li>
        );
      })}
    </ul>
    <p class="mt-10 text-center">
      <span class="inline-flex items-center gap-2 rounded-full bg-accent-soft px-5 py-2 font-semibold">{t.free}</span>
    </p>
  </section>

  <!-- join the next camp -->
  <section class="container-x pb-40 lg:pb-44">
    <div class="cta-card px-6 py-14 text-center sm:px-12 lg:py-20">
      <StairsSpinner class="absolute right-4 bottom-4 hidden w-28 opacity-80 sm:block" />
      <div class="relative mx-auto max-w-2xl">
        <h2 class="section-title">{t.joinTitle}</h2>
        <p class="mt-5 text-lg text-ink/70">{t.joinText}</p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href={INSTAGRAM_URL} {...externalLinkProps} class="btn-primary">
            <svg viewBox="0 0 24 24" class="size-5" fill="currentColor" aria-hidden="true"><path d={siInstagram.path} /></svg>
            {t.follow}
          </a>
          <a href={EMAIL_HREF} class="btn-outline">{t.write}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* photo marquee */
  .marquee {
    display: flex;
    overflow: hidden;
    padding-block: 0.75rem; /* room for the tilted cards and their shadows */
  }
  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 45s linear infinite;
  }
  .marquee-track.reverse {
    animation-direction: reverse;
  }
  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }
  @keyframes marquee {
    to { transform: translateX(-50%); }
  }

  /* camp pills light up one by one, then stay lit */
  .camp-pill {
    animation: pill-on 0.4s ease-out both;
    animation-delay: calc(0.6s + var(--i) * 0.35s);
  }
  @keyframes pill-on {
    to {
      background-color: var(--color-accent);
      color: var(--color-ink);
      box-shadow: 0 0 0 1px var(--color-accent);
      transform: scale(1.08);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee { overflow-x: auto; }
    .marquee-track { animation: none; }
    .camp-pill { animation-duration: 0s; animation-delay: 0s; }
  }
</style>
