---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import StairsSpinner from '@/components/StairsSpinner.astro';
import TeamGrid from '@/components/react/TeamGrid';
import { getTeam } from '@/data/team';
import { VOLUNTEER_FORM_URL } from '@/data/contacts';
import { languagePaths, useTranslations, type Language } from '@/i18n';

// Builds /team, /en/team and /ru/team
export const getStaticPaths = languagePaths;
const { lang } = Astro.props as { lang: Language };
const dict = useTranslations(lang);
const t = dict.team;
const members = getTeam(lang);
---

<BaseLayout lang={lang} path="/team" title={dict.nav.team} description={t.description}>
  <PageHero eyebrow={t.eyebrow} title={t.title} subtitle={t.subtitle}>
    <ul class="mt-10 flex justify-center -space-x-3" aria-hidden="true">
      {members.map((m, i) => (
        <li class="relative animate-fade-up hover:z-10" style={`animation-delay:${200 + i * 70}ms`}>
          <img src={m.photo} alt="" class="size-12 rounded-full object-cover ring-4 ring-night transition-transform duration-300 hover:-translate-y-1.5 hover:scale-110 sm:size-14" />
        </li>
      ))}
    </ul>
  </PageHero>

  <div class="relative overflow-hidden">
    <div class="container-x relative py-16 lg:py-24">
      <TeamGrid
        client:visible
        members={members}
        labels={{ leadership: t.leadership, members: t.members, more: t.more, close: t.close }}
      />
    </div>
  </div>

  <section class="container-x pb-40 lg:pb-44">
    <div class="cta-card px-6 py-14 text-center sm:px-12 lg:py-20">
      <StairsSpinner class="absolute right-4 bottom-4 w-28 opacity-80" />
      <div class="relative mx-auto max-w-2xl">
        <h2 class="section-title">{t.joinTitle}</h2>
        <p class="mt-5 text-lg text-ink/70">{t.joinText}</p>
        <a href={VOLUNTEER_FORM_URL} target="_blank" rel="noopener noreferrer" class="btn-primary mt-8">{t.joinButton}</a>
      </div>
    </div>
  </section>
</BaseLayout>
