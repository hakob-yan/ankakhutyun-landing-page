---
import { siInstagram } from 'simple-icons';
import BaseLayout from '@/layouts/BaseLayout.astro';
import StairsSpinner from '@/components/StairsSpinner.astro';
import { externalLinkProps } from '@/data/site';
import { EMAIL_HREF, INSTAGRAM_URL } from '@/data/contacts';
import { useTranslations } from '@/i18n';
import { routeLanguage } from '@/lib/articles';

// /citizen-of-independence, /en/citizen-of-independence and /ru/citizen-of-independence
const lang = routeLanguage(Astro.params.lang);
if (!lang) return new Response(null, { status: 404, statusText: 'Not found' });
const t = useTranslations(lang).citizen;
---

<BaseLayout lang={lang} path="/citizen-of-independence" title={t.title} description={t.description}>
  <!-- intro -->
  <section class="bg-cream pt-12 pb-14 lg:pt-16 lg:pb-16">
    <div class="container-x max-w-3xl">
      <p class="eyebrow">{t.eyebrow}</p>
      <h1 class="section-title">{t.title}</h1>
      <p class="mt-5 text-lg text-ink/70">{t.intro}</p>
    </div>
  </section>

  <!-- details coming soon -->
  <section class="container-x pt-20 pb-40 lg:pt-28 lg:pb-44">
    <div class="cta-card px-6 py-14 text-center sm:px-12 lg:py-20">
      <StairsSpinner class="absolute right-4 bottom-4 hidden w-28 opacity-80 sm:block" />
      <div class="relative mx-auto max-w-2xl">
        <h2 class="section-title">{t.soonTitle}</h2>
        <p class="mt-5 text-lg text-ink/70">{t.soonText}</p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href={INSTAGRAM_URL} {...externalLinkProps} class="btn-primary">
            <svg viewBox="0 0 24 24" class="size-5" fill="currentColor" aria-hidden="true"><path d={siInstagram.path} /></svg>
            {t.follow}
          </a>
          <a href={EMAIL_HREF} class="btn-outline">{t.write}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
