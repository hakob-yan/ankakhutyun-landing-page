---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { languages, localizePath, ogLocales, useTranslations, type Language } from '@/i18n';

// Font files to preload, so text is drawn in the real font right away instead of
// flashing in a system font first. `?url` gives the same hashed file the CSS uses.
import poppins400 from '@fontsource/poppins/files/poppins-latin-400-normal.woff2?url';
import poppins500 from '@fontsource/poppins/files/poppins-latin-500-normal.woff2?url';
import poppins600 from '@fontsource/poppins/files/poppins-latin-600-normal.woff2?url';
import poppins700 from '@fontsource/poppins/files/poppins-latin-700-normal.woff2?url';
import armenian400 from '@fontsource/noto-sans-armenian/files/noto-sans-armenian-armenian-400-normal.woff2?url';
import armenian500 from '@fontsource/noto-sans-armenian/files/noto-sans-armenian-armenian-500-normal.woff2?url';
import armenian600 from '@fontsource/noto-sans-armenian/files/noto-sans-armenian-armenian-600-normal.woff2?url';
import armenian700 from '@fontsource/noto-sans-armenian/files/noto-sans-armenian-armenian-700-normal.woff2?url';

interface Props {
  lang: Language;
  /** Page path without the language prefix, e.g. '/articles/foo'. Used for the language switcher and hreflang. */
  path: string;
  title?: string;
  description?: string;
  image?: string;
  /** Set to false for pages that don't exist in other languages (e.g. 404). */
  alternates?: boolean;
}
const { lang, path, title, description, image, alternates = true } = Astro.props;
const t = useTranslations(lang);
const metaDescription = description ?? t.description;
const fullTitle = title ? `${title} | ${t.siteName}` : `${t.siteName} — ${t.tagline}`;
const canonical = new URL(localizePath(path, lang), Astro.site);

// Poppins (Latin + digits) is on every page; Armenian glyphs only matter on hy pages.
// Russian has no Cyrillic web font yet (falls back to the system font), so nothing extra to preload.
const preloadFonts = [
  poppins400, poppins500, poppins600, poppins700,
  ...(lang === 'hy' ? [armenian400, armenian500, armenian600, armenian700] : []),
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1e3a5f" />
    {preloadFonts.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <link rel="icon" type="image/svg+xml" href="/logo_yellow_bg.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    {alternates && languages.map((code) => (
      <link rel="alternate" hreflang={code} href={new URL(localizePath(path, code), Astro.site)} />
    ))}
    {alternates && <link rel="alternate" hreflang="x-default" href={new URL(localizePath(path, 'hy'), Astro.site)} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <meta property="og:locale" content={ogLocales[lang]} />
  </head>
  <body class="min-h-screen">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-white">
      {t.common.skipToContent}
    </a>
    <Header lang={lang} path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
